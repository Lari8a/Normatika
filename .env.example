# ==============================================================================
# CONFIGURACIÓN DE NOTIFICACIONES A WHATSAPP - NORMATIKA
# ==============================================================================

# Puerto del servidor Node.js
PORT=3000

# Número de WhatsApp de la empresa al que llegarán las notificaciones
# (Código de país 52 para México + número a 10 dígitos, sin espacios ni guiones)
WHATSAPP_RECIPIENT_PHONE=525564359712

# ------------------------------------------------------------------------------
# OPCIÓN 1 (RECOMENDADA): Integración mediante Make (Integromat) Webhook
# ------------------------------------------------------------------------------
# Si usas Make, crea un escenario con módulo "Custom Webhook" y pega aquí su URL:
# Ejemplo: https://hook.eu1.make.com/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAKE_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# OPCIÓN 2: Integración directa mediante WhatsApp Business Cloud API (Meta Developers)
# ------------------------------------------------------------------------------
# Si prefieres conectar directamente la Cloud API de Meta sin intermediarios:
# 1. Token de acceso permanente (System User Token de Meta Business):
WHATSAPP_API_TOKEN=
# 2. Identificador del número de teléfono (Phone Number ID en Meta Developer Console):
WHATSAPP_PHONE_NUMBER_ID=
